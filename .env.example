# ClassFlow — Environment Variables
# Copy ke .env.local dan isi dengan nilai project Supabase kamu.
# Di Vercel: masukkan ketiga variabel ini di Project Settings → Environment Variables.

# Client-safe (boleh di browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY — jangan pernah di-expose ke client / tanpa prefix NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_...

# Opsional: koneksi langsung Postgres (hanya untuk script DB lokal)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
